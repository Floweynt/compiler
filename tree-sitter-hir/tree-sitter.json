{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "hir",
      "camelcase": "Hir",
      "title": "High-level Intermediate Representation",
      "scope": "source.hir",
      "file-types": [
        "hir"
      ],
      "injection-regex": "^hir$",
      "class-name": "TreeSitterHir",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "GPL-3.0-or-later",
    "description": "Stack machine based IR for target independent optimization and compilation",
    "authors": [
      {
        "name": "Flowey",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-hir",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
